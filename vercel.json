{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.asbestosremoval-leeds.co.uk"
        }
      ],
      "destination": "https://asbestosremoval-leeds.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/asbestos-removal-companies-leeds-west-yorkshire.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/asbestos-removal-companies-leeds-west-yorkshire",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/asbestos-removal-contractors-leeds-west-yorkshire.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/asbestos-removal-contractors-leeds-west-yorkshire",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
